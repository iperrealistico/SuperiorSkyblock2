package com.bgsoftware.superiorskyblock.nms.${NMS_VERSION}.dragon;

import com.bgsoftware.common.annotations.Nullable;
import com.bgsoftware.superiorskyblock.SuperiorSkyblockPlugin;
import com.bgsoftware.superiorskyblock.api.island.Island;
import com.bgsoftware.superiorskyblock.api.island.cache.IslandCache;
import com.bgsoftware.superiorskyblock.api.island.cache.IslandCacheKey;
import com.bgsoftware.superiorskyblock.island.cache.IslandCacheKeys;
import com.bgsoftware.superiorskyblock.core.threads.BukkitExecutor;
import com.bgsoftware.superiorskyblock.nms.${NMS_VERSION}.dragon.IslandEndDragonFight;
import net.minecraft.core.BlockPos;
import org.bukkit.World;
import org.bukkit.Location;

import java.util.Collections;
import java.util.ArrayList;
import java.util.List;
import java.util.concurrent.ConcurrentHashMap;
import java.util.Map;
import java.util.UUID;

public class EndWorldEndDragonFightHandler {

    private static final IslandCacheKey<IslandEndDragonFight> CACHE_KEY = IslandCacheKeys.register("DRAGON_FIGHT", IslandEndDragonFight.class);

    private final Map<UUID, IslandEndDragonFight> worldDragonFights = new ConcurrentHashMap<>();
    private volatile World world;

    EndWorldEndDragonFightHandler() {
    }

    public void tick() {
        if (!BukkitExecutor.isFolia())
            this.worldDragonFights.values().forEach(IslandEndDragonFight::tick);
    }

    public void addDragonFight(IslandCache islandCache, IslandEndDragonFight endDragonFight) {
        this.world = endDragonFight.getBukkitWorld();
        IslandEndDragonFight oldDragonFight = islandCache.store(CACHE_KEY, endDragonFight);
        if (oldDragonFight != null && oldDragonFight != endDragonFight) {
            this.worldDragonFights.remove(oldDragonFight.getIsland().getUniqueId(), oldDragonFight);
            // The old fight is no longer ticked, so its boss bar would stay visible to its players forever.
            oldDragonFight.stop();
        }
        this.worldDragonFights.put(endDragonFight.getIsland().getUniqueId(), endDragonFight);
    }

    @Nullable
    public IslandEndDragonFight getDragonFight(IslandCache islandCache) {
        return islandCache.get(CACHE_KEY);
    }

    @Nullable
    public IslandEndDragonFight getDragonFightAt(BlockPos blockPos) {
        World world = this.world;
        if (world != null) {
            Island island = SuperiorSkyblockPlugin.getPlugin().getGrid().getIslandAt(
                    new Location(world, blockPos.getX(), blockPos.getY(), blockPos.getZ()));
            return island == null ? null : worldDragonFights.get(island.getUniqueId());
        }
        int chunkX = blockPos.getX() >> 4;
        int chunkZ = blockPos.getZ() >> 4;

        for (IslandEndDragonFight endDragonFight : this.worldDragonFights.values()) {
            if (endDragonFight.getIsland().isInside(chunkX, chunkZ))
                return endDragonFight;
        }

        return null;
    }

    public List<IslandEndDragonFight> getDragonFights() {
        return Collections.unmodifiableList(new ArrayList<>(this.worldDragonFights.values()));
    }

    @Nullable
    public IslandEndDragonFight removeDragonFight(IslandCache islandCache) {
        IslandEndDragonFight endDragonFight = islandCache.remove(CACHE_KEY);
        if (endDragonFight != null)
            this.worldDragonFights.remove(endDragonFight.getIsland().getUniqueId(), endDragonFight);
        return endDragonFight;
    }

}
